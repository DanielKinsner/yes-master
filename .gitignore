# Build outputs
dist/
build/
target/
# Scratch target dir used by the dev-binary-lock workaround
# (`cargo test --target-dir target-tests` when `npm run tauri dev` is
# holding `target/debug/yes-master.exe` open). Pattern is
# distinct from `target/` so list it separately.
target-tests/
out/
.next/
.vite/

# TypeScript incremental build artifacts
*.tsbuildinfo
# NOTE (audit B-01): vite.config.js / vite.config.d.ts are deliberately NOT
# ignored. Vite resolves .js before .ts, so an emitted shadow config must show
# up as an untracked file (and fail src/build-config.test.ts), never hide.

# Tauri-generated schemas and manifests (regenerated by `tauri-build` on every compile)
src-tauri/gen/
apps/iphone/src-tauri/gen/

# Native iPhone project generated from apps/iphone-native/project.yml
apps/iphone-native/*.xcodeproj/

# Android: machine-local SDK pointer, Gradle caches, and the cargo-ndk-built
# .so (regenerated by the app's cargoNdk Gradle task — never committed).
apps/android-native/local.properties
apps/android-native/.gradle/
apps/android-native/app/src/main/jniLibs/

# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Private audio and generated renders
private-audio-fixtures/
tests for presets/
outputs/
renders/
test-output/
test-output/private-fixture-matrix/
test-output/private-reference-tuning/
test-output/**
*.wav
*.wav.*.tmp
*.aiff
*.aif
*.flac
*.mp3
*.m4a
*.aac
*.ogg
*.opus

# Re-include the dialog-smoke fixture artifact so a fresh Claude session
# has a tangible .ams.json to compare against without rerunning the
# `cargo run --bin produce_dialog_smoke` binary first.  The binary
# regenerates this file deterministically; tracking it keeps the schema
# reviewable in PR diffs.
!test-output/
!test-output/tauri-project-dialogs-smoke/
!test-output/tauri-project-dialogs-smoke/native-dialog-save-as.ams.json
# The default-deny `test-output/**` above keeps private CSV/JSON ledgers,
# screenshots, logs, and rendered masters ignored even when new runner folders
# are added. The dialog-smoke .ams.json fixture above is the only exception.

# graphify knowledge graph (graphify-out/). graph.json, community labels, and
# GRAPH_REPORT.md are path-clean shared artifacts and stay tracked. The
# extraction cache, manifest.json, and cost.json embed absolute paths and
# mtimes from one machine — they cannot warm caches anywhere else and would
# churn on every regeneration, so they are local-only (owner decision
# 2026-06-09; docs/reviews/2026-06-10-consolidated-refactor-backlog.md, P1).
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
# Regenerate anytime with `graphify export html` (reads graph.json).
graphify-out/graph.html

# Local/editor
.env
.env.*
.DS_Store
Thumbs.db
.idea/
.vscode/
# Claude Code local workspace config (e.g. launch.json) — local-only, not shared.
.claude/
docs/READING_THE_METERS.md

.vercel
