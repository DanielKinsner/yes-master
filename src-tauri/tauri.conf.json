{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YES Master",
  "version": "0.9.0",
  "identifier": "com.yesmaster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YES Master",
        "width": 1920,
        "height": 1080,
        "minWidth": 1360,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Daniel Kinsner",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/DanielKinsner/yes-master/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0NjBGMUQ5QjY3QTBBQkYKUldTL0NucTIyZkZnVkE0U1NpdG1oZFBMM2VGbEhTNVNqNDFhTk9wb3ZKN1o4MkhKTjhpdEpTVGQK"
    }
  }
}
