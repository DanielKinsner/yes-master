{
  "name": "yes-master",
  "private": true,
  "version": "0.9.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mac": "rm -f src-tauri/target/release/produce_dialog_smoke && tauri build --bundles app,dmg",
    "build:windows": "rimraf src-tauri/target/release/produce_dialog_smoke.exe && tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:fast": "powershell -ExecutionPolicy Bypass -File scripts/verify-fast.ps1",
    "verify:frontend": "powershell -ExecutionPolicy Bypass -File scripts/verify-fast.ps1 -Lane frontend",
    "verify:landing": "node scripts/verify-landing-responsive.mjs",
    "verify:rust": "powershell -ExecutionPolicy Bypass -File scripts/verify-fast.ps1 -Lane rust",
    "verify:iphone": "powershell -ExecutionPolicy Bypass -File scripts/verify-fast.ps1 -Lane iphone",
    "verify:android": "powershell -ExecutionPolicy Bypass -File scripts/verify-fast.ps1 -Lane android",
    "verify:headless": "node scripts/verify-headless.mjs",
    "capture:landing": "node scripts/capture-landing-assets.mjs",
    "verify:landing-assets": "node scripts/verify-landing-assets.mjs",
    "optimize:landing-art": "node scripts/optimize-landing-art.mjs",
    "verify:landing-smoke": "node scripts/verify-landing-responsive.mjs --smoke --url"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^19.2.8",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.61.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  }
}
